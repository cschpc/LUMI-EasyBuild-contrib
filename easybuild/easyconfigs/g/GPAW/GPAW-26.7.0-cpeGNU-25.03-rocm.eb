#DOC This is a version of GPAW built for LUMI-G.
easyblock = "PythonPackage"

local_gpaw_data_version  = '1.0.1'   # https://gpaw.readthedocs.io/setups/setups.html#setup-releases
local_libxc_version      = '7.0.0'   # https://libxc.gitlab.io/changes/
local_libvdwxc_version   = '0.5.0'   # https://launchpad.net/libvdwxc/stable/
local_cupy_version       = '13.6.0'
local_magma_version      = '2.8.0'
local_setuptools_version = '79.0.1'  # https://pypi.org/project/setuptools/#history
local_pybind11_version   = '3.0.1'   # https://pypi.org/project/pybind11/#history
local_packaging_version  = '24.2'    # required by setuptools>=77
local_typing_ext_version = '4.16.0'  # required by ase>=3.29.0

name = 'GPAW'
version = '26.7.0'
versionsuffix = '-rocm'

homepage = 'https://wiki.fysik.dtu.dk/gpaw/'
description = """GPAW is a density-functional theory (DFT) Python code based on the projector-augmented wave (PAW)
 method and the atomic simulation environment (ASE). It uses real-space uniform grids and multigrid methods or
 atom-centered basis-functions."""

toolchain = {'name': 'cpeGNU', 'version': '25.03'}
toolchainopts = {'usempi': True, 'openmp': True}

# The PyPI sdist for this version is broken (missing files), so use the
# GitLab release archive instead.
sources = [{
     'filename': SOURCELOWER_TAR_GZ,
     'source_urls': ['https://gitlab.com/gpaw/gpaw/-/archive/%(version)s'],
}]
patches = [
   {'name': 'GPAW-%(version)s-siteconfig-gpu.patch', 'level': 1},
   {'name': 'GPAW-%(version)s-fix-dependency-versions.patch', 'level': 1},
]
checksums = [
    {'gpaw-26.7.0.tar.gz': 'a1623c0575a37a662c64bad708b8a1caa6b505c105d9d494e3371575f6905386'},
    {'GPAW-26.7.0-siteconfig-gpu.patch': '779bf77260f9a3ca9c8de7c94479be9f6e182f31410f5d8d510f9969333dd261'},
    {'GPAW-26.7.0-fix-dependency-versions.patch': '192c7d7cdb3c14a8a0bf140c61168960a19ba4c4c18ce41d4ecb42a8effc809f'},
]

builddependencies = [
    # Provides wheel
    ('buildtools-python', '%(toolchain_version)s', '-cray-python%(pyshortver)s', True),
]

dependencies = [
    ('cray-python/3.11.7',  EXTERNAL_MODULE),
    ('cray-fftw/3.3.10.10', EXTERNAL_MODULE),
    ('rocm/6.3.4',          EXTERNAL_MODULE),
    ('libxc',               local_libxc_version, '-FHC'),
    ('gpaw-data',           local_gpaw_data_version),
    ('CuPy',                local_cupy_version, '-rocm'),
    ('magma',               local_magma_version, '-rocm'),
]

# Update buildtools and prepend to PYTHONPATH (build-only).
# The typing-extensions is also needed at runtime,
# so install it into the module's site-packages and prepend
# that too to make build succeed.
local_build_pythonpath = (
    'python3 -m pip install --ignore-installed --prefix %(builddir)s/buildtools'
    ' setuptools==' + local_setuptools_version +
    ' pybind11==' + local_pybind11_version +
    ' packaging==' + local_packaging_version + ' && '
    'python3 -m pip install --ignore-installed --prefix %(installdir)s'
    ' typing-extensions==' + local_typing_ext_version + ' && '
    'export PYTHONPATH=%(builddir)s/buildtools/lib/python%(pyshortver)s/site-packages:'
    '%(installdir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH && '
)

prebuildopts = local_build_pythonpath + 'GPAW_CONFIG=siteconfig-lumi-gpu.py '
preinstallopts = prebuildopts

download_dep_fail = False
use_pip = True
use_pip_for_deps = True
pip_verbose = True
pip_ignore_installed = False
pip_no_index = False
sanity_pip_check = True

sanity_check_paths = {
    'files': ['bin/gpaw%s' % x for x in ['', '-analyse-basis', '-basis', '-plot-parallel-timings',
                                         '-runscript', '-setup', '-upfplot']],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = [
    "gpaw info"
]

moduleclass = 'chem'
